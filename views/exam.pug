
doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous"
    )
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css"
    )
    link(rel="stylesheet" href="/style.css")
    title= examTitle

  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto
          = examTitle
          i.bi-journal-check.ms-1

    if isResult
      div.card.my-3
        div.card-body.text-center
          h2.card-title 試験結果
          h3.my-4
            = `${score}点`
          if isPassed
            h4.text-success 合格
          else
            h4.text-danger 不合格
          p.card-text
            = `正答数：${correctCount} / ${results.length}問`
          p.card-text
            = `合格基準：${passingScore}点`

      each question in results
        div.card.my-3
          div.card-body
            h5.card-title
              = `問題 ${question.questionId}`
              if question.isCorrect
                span.text-success.ms-2 正解
              else
                span.text-danger.ms-2 不正解

            p.card-text.lead= question.question

            each choice, index in question.choices
              - const isUserAnswer = question.userAnswer !== null && Number(question.userAnswer) === index
              - const isCorrectAnswer = question.correctAnswer === index
              - let choiceClass = 'border-secondary'
              - if (isUserAnswer && question.isCorrect) choiceClass = 'border-success border-2'
              - else if (isUserAnswer && !question.isCorrect) choiceClass = 'border-danger border-2'
              - else if (isCorrectAnswer) choiceClass = 'border-success border-2'

              div.choice-option.border.rounded.p-3.mb-2(class=choiceClass)
                input.form-check-input.me-2(
                  type="radio"
                  checked=isUserAnswer
                  disabled
                )
                span= choice

      div.d-grid.my-4
        a.btn.btn-primary.btn-lg(href=`/exam?id=${examId}`)
          i.bi-arrow-repeat.me-1
          | もう一度受験する
      div.d-grid.my-4
        a.btn.btn-primary.btn-lg(href=`/`)
          i.bi-house.me-1
          | 試験一覧に戻る

    else
      div.card.my-3
        div.card-body
          h5.card-title 試験について
          p.card-text= description

      form(method="post" action="/exam")
        input(type="hidden" name="oneTimeToken" value=oneTimeToken)

        each question in questions
          div.card.my-3.question-card
            div.card-body
              h5.card-title 問題 #{question.id}
              p.card-text.lead= question.question

              each choice, index in question.choices
                label.choice-option.border.rounded.p-3.mb-2
                  input.form-check-input.me-2(
                    type="radio"
                    name=`answer_${question.id}`
                    value=index
                    id=`q${question.id}_${index}`
                  )
                  span= choice

        div.d-grid.my-4
          button(type="submit").btn.btn-primary.btn-lg
            i.bi-send.me-1
            | 回答を提出する
